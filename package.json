{
  "name": "hey-ai",
  "version": "0.6.2",
  "description": "AI-powered CLI for quick terminal questions - gathers context and suggests commands",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hey-ai": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "test:package": "node scripts/package-smoke.mjs",
    "build:link": "npm run build && npm link",
    "prepack": "pnpm run build",
    "prepare": "husky"
  },
  "engines": {
    "node": "^22.13.0"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "terminal",
    "shell",
    "gpt",
    "claude",
    "openai"
  ],
  "author": "",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sqlite-vss"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/openai": "^4.0.47",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.79",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "clipboardy": "^5.3.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "globby": "^16.2.4",
    "ignore": "^7.0.6",
    "inquirer": "^13.4.3",
    "sqlite-vss": "^0.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@jest/globals": "^30.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "conventional-changelog-cli": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewHuffman/hey-ai.git"
  },
  "bugs": {
    "url": "https://github.com/AndrewHuffman/hey-ai/issues"
  },
  "homepage": "https://github.com/AndrewHuffman/hey-ai#readme"
}
